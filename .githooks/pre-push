#!/bin/bash
#
# Git pre-push hook
# - Runs unit tests before pushing
# - Blocks direct pushes to main branch
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Block direct pushes to main
protected_branch='main'
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

if [ "$protected_branch" = "$current_branch" ]; then
    echo ""
    echo -e "${RED}❌ Direct pushes to '$protected_branch' are not allowed.${NC}"
    echo "Create a feature branch and open a pull request instead."
    exit 1
fi

echo -e "${YELLOW}Running tests before push...${NC}"
echo ""

# Check Go is installed
if ! command -v go &> /dev/null; then
    echo -e "${RED}❌ Go is not installed!${NC}"
    echo "Install Go 1.21+: https://go.dev/dl/"
    exit 1
fi

# Get repo root
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Run tests
if go test ./...; then
    echo ""
    echo -e "${GREEN}✅ Tests passed! Pushing...${NC}"
    exit 0
else
    echo ""
    echo -e "${RED}❌ Tests failed! Push aborted.${NC}"
    echo "Fix tests or bypass with: git push --no-verify"
    exit 1
fi
